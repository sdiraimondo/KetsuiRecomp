+// A saved game is a fixed-size container on the console, and the game checks its
+// size when it loads the data (0xF000 bytes). Create and extend it to that size.
+constexpr uintmax_t kSavedGameFileSize = 0xF000;
+
+void SizeSavedGameFile(const std::filesystem::path& package_file, const XCONTENT_AGGREGATE_DATA& data) {
+  if (data.content_type != XContentType::kSavedGame) {
+    return;
+  }
+  std::error_code ec;
+  if (!std::filesystem::exists(package_file, ec)) {
+    rex::filesystem::CreateEmptyFile(package_file);
+  }
+  if (std::filesystem::file_size(package_file, ec) != kSavedGameFileSize) {
+    std::filesystem::resize_file(package_file, kSavedGameFileSize, ec);
+  }
